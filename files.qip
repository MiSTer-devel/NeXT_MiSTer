set_global_assignment -name QIP_FILE rtl/ap68040/rtl/ap040.qip
set_global_assignment -name VERILOG_FILE rtl/next/dpram.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_system.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_scr.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_intc.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_timer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_vram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_bmap.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_dma_stub.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_scc.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_scsi.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_floppy.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_enet_dma.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_mo.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_cd_audio.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_kms_snd.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_snd_in.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_audio_adc.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_printer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_ddram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_ddram_arb.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_enet_bridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_exception_mailbox.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/next/next_exception_trigger.sv
# The exception instrumentation is opt-in and off by default.  It costs most
# of the remaining ALM headroom and overrides the project's SPEED technique
# and seed, so a normal RBF must not carry it.  Build a diagnostic bitstream
# with the whole flow under the variable, so every stage sees the same
# assignments:
#
#   NEXT_EXCEPTION_DIAG=1 quartus_sh --flow compile NeXT
#
# The two modules above stay listed unconditionally: with the macro clear
# NeXT.sv's generate takes its pass-through branch and never instantiates
# them, so they cost nothing and the lint still covers them.
if {[info exists ::env(NEXT_EXCEPTION_DIAG)]
    && $::env(NEXT_EXCEPTION_DIAG) eq "1"} {
	set_global_assignment -name VERILOG_MACRO "NEXT_EXCEPTION_DIAG=1"
	set_global_assignment -name FITTER_AGGRESSIVE_ROUTABILITY_OPTIMIZATION ALWAYS
	# Preserve the full diagnostic design while reducing synthesized logic area.
	set_global_assignment -name OPTIMIZATION_TECHNIQUE AREA
	set_global_assignment -name SEED 2
}
# The Quadra 800 AP68040 tree places but does not route under this project's
# HIGH PERFORMANCE / SPEED settings (docs/CPU_NEXT_PORT.md).  This is the
# recipe MacQuadra800_MiSTer closes the same CPU with:
#
#   NEXT_FIT_QUADRA=1 quartus_sh --flow compile NeXT
if {[info exists ::env(NEXT_FIT_QUADRA)] && $::env(NEXT_FIT_QUADRA) eq "1"} {
	set_global_assignment -name OPTIMIZATION_MODE BALANCED
	set_global_assignment -name OPTIMIZATION_TECHNIQUE BALANCED
	set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION OFF
	set_global_assignment -name FITTER_AGGRESSIVE_ROUTABILITY_OPTIMIZATION ALWAYS
	# NEXT_SEED=<n> walks the fitter seed: at 94% ALMs a netlist change can
	# fail to route on one seed and close on the next (MacQuadra800 keeps a
	# log of the same in its qsf).
	if {[info exists ::env(NEXT_SEED)]} {
		set_global_assignment -name SEED $::env(NEXT_SEED)
	}
}
set_global_assignment -name QIP_FILE rtl/pll.qip
set_global_assignment -name SDC_FILE NeXT.sdc
set_global_assignment -name SYSTEMVERILOG_FILE NeXT.sv
