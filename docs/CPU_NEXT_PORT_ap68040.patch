diff -ruN a/tb/asm/t_dbccfloor.s b/tb/asm/t_dbccfloor.s
--- a/tb/asm/t_dbccfloor.s	1969-12-31 19:00:00.000000000 -0500
+++ b/tb/asm/t_dbccfloor.s	2026-10-18 23:38:17.270387671 -0400
@@ -0,0 +1,164 @@
+; AP68040: the DBcc period floor (the dbcc_floor input, bench register $F10C)
+; assembled with vasmm68k_mot -Fbin -m68040
+;
+; A host whose firmware times a bare "dbf d0,*" loop against a real 68040's
+; 4 clocks per taken DBcc (the NeXT ROM's delay()) sets dbcc_floor so that
+; a DBcc following a taken DBcc leaves EX no earlier than that many clocks
+; after it.  The program times its loops with the bench's clock count
+; ($F2EC, a noncachable read) and checks:
+;   1    floor 0: 999 taken dbf cost well under 9 clocks each (the loop's
+;        natural rate, 2-3 clocks)
+;   2    floor 9: at least 9 clocks per taken dbf, and not more than the
+;        floor plus the bracketing overhead
+;   3    floor 4: the same at 4
+;   4    a subq/bne loop runs the same with floor 9 as with floor 0: the
+;        floor slows only DBcc
+;   5    a never-taken dbf (counter 0) in a bne loop runs the same with
+;        floor 9 as with floor 0: only a TAKEN DBcc arms the floor
+;   6    floor 9 then floor 0 again: the floor releases (nothing sticks)
+
+FAILREG	equ	$F100
+DONEREG	equ	$F102
+FLOOR	equ	$F10C		; bench: the core's dbcc_floor input (word)
+CYCLES	equ	$F2EC		; bench: the clock count (long, read)
+
+ITER	equ	1000		; dbf executions per timed loop (999 taken)
+SLACK	equ	256		; bracketing overhead allowed (two bus reads, the
+				; exit mispredict, wait states and BCLK/2)
+
+failt	macro
+	move.w	#\1,d7
+	bra	fail_all
+	endm
+
+	org	0
+	dc.l	$3400
+	dc.l	start
+	rept	254
+	dc.l	unexp
+	endr
+
+	org	$400
+start:
+	move.l	#$0000A040,d0		; DTT1: supervisor data noncachable
+	movec	d0,dtt1			; (the bench registers)
+	move.l	#$80008000,d0		; both caches on
+	movec	d0,cacr
+	move.w	#$2700,sr
+
+; warm the instruction cache and the branch predictors on every timed loop
+	move.w	#0,(FLOOR).l
+	bsr	meas_dbf
+	bsr	meas_bne
+	bsr	meas_ntk
+
+;------------------------------------------------- 1 floor 0: the natural rate
+	move.w	#0,(FLOOR).l
+	bsr	meas_dbf
+	move.l	d2,d3			; d3 = cycles at floor 0
+	cmp.l	#(ITER-1)*6,d2		; well under 9 a pass (2-3 natural)
+	bhs	fail1
+
+;------------------------------------------------- 2 floor 9
+	move.w	#9,(FLOOR).l
+	bsr	meas_dbf
+	cmp.l	#(ITER-1)*9,d2
+	blo	fail2
+	cmp.l	#(ITER-1)*9+SLACK,d2
+	bhi	fail3
+
+;------------------------------------------------- 3 floor 4
+	move.w	#4,(FLOOR).l
+	bsr	meas_dbf
+	cmp.l	#(ITER-1)*4,d2
+	blo	fail4
+	cmp.l	#(ITER-1)*4+SLACK,d2
+	bhi	fail5
+
+;------------------------------------------------- 4 subq/bne: not a DBcc
+	move.w	#0,(FLOOR).l
+	bsr	meas_bne
+	move.l	d2,d4
+	move.w	#9,(FLOOR).l
+	bsr	meas_bne
+	sub.l	d4,d2			; floor 9 minus floor 0
+	bpl.s	.p4
+	neg.l	d2
+.p4:	cmp.l	#SLACK,d2
+	bhi	fail6
+
+;------------------------------------------------- 5 a never-taken dbf
+	move.w	#0,(FLOOR).l
+	bsr	meas_ntk
+	move.l	d2,d4
+	move.w	#9,(FLOOR).l
+	bsr	meas_ntk
+	sub.l	d4,d2
+	bpl.s	.p5
+	neg.l	d2
+.p5:	cmp.l	#SLACK,d2
+	bhi	fail7
+
+;------------------------------------------------- 6 the floor releases
+	move.w	#0,(FLOOR).l
+	bsr	meas_dbf
+	sub.l	d3,d2			; against test 1's count
+	bpl.s	.p6
+	neg.l	d2
+.p6:	cmp.l	#SLACK,d2
+	bhi	fail8
+
+	move.w	#$600D,(DONEREG).l
+	bra.s	*
+
+; d2 = clocks around ITER executions of an aligned "dbf d0,*"
+meas_dbf:
+	move.w	#ITER-1,d0
+	move.l	(CYCLES).l,d1
+	cnop	0,4
+.a:	dbf	d0,.a
+	move.l	(CYCLES).l,d2
+	sub.l	d1,d2
+	rts
+
+; d2 = clocks around ITER passes of a subq/bne loop
+meas_bne:
+	move.l	#ITER,d0
+	move.l	(CYCLES).l,d1
+	cnop	0,4
+.b:	subq.l	#1,d0
+	bne.s	.b
+	move.l	(CYCLES).l,d2
+	sub.l	d1,d2
+	rts
+
+; d2 = clocks around ITER passes of a bne loop holding a dbf that is never
+; taken (its counter is 0 on every pass)
+meas_ntk:
+	move.l	#ITER,d0
+	move.l	(CYCLES).l,d5
+	cnop	0,4
+.c:	moveq	#0,d1
+	dbf	d1,.c			; d1 = 0 -> -1: falls through every time
+	subq.l	#1,d0
+	bne.s	.c
+	move.l	(CYCLES).l,d2
+	sub.l	d5,d2
+	rts
+
+fail1:	failt	1
+fail2:	failt	2
+fail3:	failt	3
+fail4:	failt	4
+fail5:	failt	5
+fail6:	failt	6
+fail7:	failt	7
+fail8:	failt	8
+
+fail_all:
+	move.w	d7,(FAILREG).l
+	move.w	#$BAD,(DONEREG).l
+	bra.s	*
+
+unexp:
+	failt	99
diff -ruN a/tb/asm/t_nx8k.s b/tb/asm/t_nx8k.s
--- a/tb/asm/t_nx8k.s	1969-12-31 19:00:00.000000000 -0500
+++ b/tb/asm/t_nx8k.s	2026-10-19 01:27:17.017037761 -0400
@@ -0,0 +1,216 @@
+; AP68040: the NeXT kernel's page-table shape, reproduced from a hardware dump
+; (2026-10-19): 8 KB pages (TC $C000), the kernel's own memory under a
+; supervisor-only copyback transparent translation (ITT0/DTT0), and a VA in
+; the 0x10000000 window mapped by a three-level table whose root and pointer
+; descriptors are type 10 (not 11, as every other test here writes them) and
+; whose page descriptor is resident, U, M, copyback, global ($...439).  The
+; tables are written with the data cache on (copyback) and never pushed, as
+; the kernel does.  On the board a supervisor write through such a mapping
+; faulted (ATC fault) on every retry although the tables were valid.
+;   1    the mapping valid before the access: a write and a read through it
+;        reach the physical page, no fault
+;   2    the page descriptor invalid at first: the access error handler
+;        makes it valid and PFLUSHANs; the retried write must succeed
+;        (exactly one fault)
+;   3    the same with PFLUSHA
+;   4    the same with a descriptor the handler had READ (a clean cached
+;        copy) before writing it
+;   5    the same for a pointer descriptor made valid by the handler
+FAILREG	equ	$F100
+DONEREG	equ	$F102
+
+ROOT	equ	$20000
+PTR	equ	$20200
+PAGE	equ	$20400		; 32 entries of 8 KB pages
+PTR2	equ	$20600		; for test 5
+PAGE2	equ	$20800
+PHYS	equ	$30000		; physical pages $30000, $32000, $34000, $36000
+VA	equ	$10004494	; root 8, pointer 0, page 2
+VA3	equ	$10006494	; page 3
+VA4	equ	$10008494	; page 4
+VA5	equ	$10044494	; root 8, pointer 1, page 2 (PTR2/PAGE2)
+VA6	equ	$1000a494	; page 5
+
+cnt_aerr	equ	$3600
+fix_addr	equ	$3604
+fix_val		equ	$3608
+flush_mode	equ	$360C		; 0 pflushan, 1 pflusha
+last_fa		equ	$3610
+last_ssw	equ	$3614
+
+failt	macro
+	move.w	#\1,d7
+	bra	fail_all
+	endm
+
+chkl	macro
+	cmp.l	#\2,\1
+	beq.s	.ok\@
+	failt	\3
+.ok\@:
+	endm
+
+	org	0
+	dc.l	$3400
+	dc.l	start
+	dc.l	h_aerr		; 2 access error
+	rept	253
+	dc.l	unexp
+	endr
+
+	org	$400
+start:
+	move.w	#$2700,sr
+	clr.l	(cnt_aerr).l
+	clr.l	(flush_mode).l
+	move.l	#$80008000,d0		; caches on: the tables are written copyback
+	movec	d0,cacr
+
+; the kernel's transparent translation for its own memory: ITT0 = DTT0 =
+; base 0, mask 0 (this 16 MB), E, S = supervisor only, CM = copyback
+	move.l	#$0000A020,d0
+	movec	d0,itt0
+	movec	d0,dtt0
+	moveq	#0,d0
+	movec	d0,itt1
+	movec	d0,dtt1
+
+; the tables, as the kernel writes them (cached stores, never pushed)
+	lea	(ROOT).l,a0
+	moveq	#0,d0
+	move.w	#127,d1
+.cr:	move.l	d0,(a0)+
+	dbf	d1,.cr
+	lea	(PTR).l,a0
+	move.w	#127,d1
+.cp:	move.l	d0,(a0)+
+	dbf	d1,.cp
+	lea	(PTR2).l,a0
+	move.w	#127,d1
+.cp2:	move.l	d0,(a0)+
+	dbf	d1,.cp2
+	lea	(PAGE).l,a0
+	move.w	#31,d1
+.cg:	move.l	d0,(a0)+
+	dbf	d1,.cg
+	lea	(PAGE2).l,a0
+	move.w	#31,d1
+.cg2:	move.l	d0,(a0)+
+	dbf	d1,.cg2
+	move.l	#PTR+$A,(ROOT+8*4).l		; root[8]: type 10, U
+	move.l	#PAGE+$A,(PTR+0).l		; ptr[0]:  type 10, U
+	move.l	#PHYS+$439,(PAGE+2*4).l		; page[2]: resident U M CM=copyback G
+	; page[3], page[4], page[5], ptr[1] stay invalid for tests 2-5
+
+; the physical pages carry a pattern to see what a read returns
+	move.l	#$11111111,(PHYS).l
+	move.l	#$22222222,(PHYS+$494).l
+	move.l	#$33333333,(PHYS+$2494).l
+	move.l	#$44444444,(PHYS+$4494).l
+	move.l	#$55555555,(PHYS+$6494).l
+
+; enable: SRP (and URP), TC = E + 8K pages, as the kernel does
+	move.l	#ROOT,d0
+	movec	d0,srp
+	movec	d0,urp
+	pflusha
+	move.l	#$C000,d0
+	movec	d0,tc
+
+;------------------------------------------------- 1 the valid mapping
+	move.l	(VA).l,d0
+	chkl	d0,$22222222,1			; read through the mapping
+	move.l	#$600D0001,(VA).l		; the write that looped on the board
+	move.l	(PHYS+$494).l,d0
+	chkl	d0,$600D0001,2			; reached the physical page
+	move.l	(cnt_aerr).l,d0
+	chkl	d0,0,3				; and no fault
+
+;------------------------------------------------- 2 fault, fix, PFLUSHAN, retry
+	move.l	#PAGE+3*4,(fix_addr).l
+	move.l	#PHYS+$2000+$439,(fix_val).l
+	move.l	#$600D0002,(VA3).l
+	move.l	(cnt_aerr).l,d0
+	chkl	d0,1,4				; exactly one fault
+	move.l	(PHYS+$2494).l,d0
+	chkl	d0,$600D0002,5			; the retried write landed
+	move.l	(VA3).l,d0
+	chkl	d0,$600D0002,6
+
+;------------------------------------------------- 3 the same with PFLUSHA
+	move.l	#1,(flush_mode).l
+	move.l	#PAGE+4*4,(fix_addr).l
+	move.l	#PHYS+$4000+$439,(fix_val).l
+	move.l	#$600D0003,(VA4).l
+	move.l	(cnt_aerr).l,d0
+	chkl	d0,2,7
+	move.l	(PHYS+$4494).l,d0
+	chkl	d0,$600D0003,8
+	clr.l	(flush_mode).l
+
+;------------------------------------------------- 4 a clean cached copy of the descriptor first
+	move.l	(PAGE+5*4).l,d0			; read it (invalid, 0): the line is now cached
+	chkl	d0,0,9
+	cpusha	dc				; and clean in the cache, current in memory
+	move.l	#PAGE+5*4,(fix_addr).l
+	move.l	#PHYS+$6000+$439,(fix_val).l
+	move.l	#$600D0004,(VA6).l
+	move.l	(cnt_aerr).l,d0
+	chkl	d0,3,10
+	move.l	(PHYS+$6494).l,d0
+	chkl	d0,$600D0004,11
+
+;------------------------------------------------- 5 a pointer descriptor made valid by the handler
+	move.l	#PHYS+$439,(PAGE2+2*4).l	; page2[2] valid already (maps VA5 to PHYS)
+	move.l	#PTR+1*4,(fix_addr).l		; ptr[1] -> PAGE2, written by the handler
+	move.l	#PAGE2+$A,(fix_val).l
+	move.l	#$600D0005,(VA5).l
+	move.l	(cnt_aerr).l,d0
+	chkl	d0,4,12
+	move.l	(PHYS+$494).l,d0
+	chkl	d0,$600D0005,13
+
+	bsr	nocache				; the bench registers: not through the copyback TTR
+	move.w	#$600D,(DONEREG).l
+	bra.s	*
+
+; DTT0 to supervisor noncachable, so the result writes reach the bench
+nocache:
+	move.l	#$0000A040,d0
+	movec	d0,dtt0
+	cpusha	dc
+	rts
+
+; access error: format 7 vector 2, an ATC fault; make the descriptor at
+; fix_addr valid (a cached store, as the kernel's), flush, restart
+h_aerr:
+	cmpi.w	#$7008,6(sp)
+	bne	hfail
+	movem.l	d0/a0,-(sp)
+	move.w	$14(sp),(last_ssw).l		; SSW (frame +$C, after movem +8)
+	move.l	$1C(sp),(last_fa).l		; FA  (frame +$14)
+	move.w	$14(sp),d0
+	and.w	#$0400,d0			; must be an ATC fault
+	beq	hfail
+	movea.l	(fix_addr).l,a0
+	move.l	(fix_val).l,(a0)
+	tst.l	(flush_mode).l
+	bne.s	.pa
+	pflushan
+	bra.s	.done
+.pa:	pflusha
+.done:	addq.l	#1,(cnt_aerr).l
+	move.l	(cnt_aerr).l,d0
+	cmp.l	#8,d0				; a loop: more faults than the tests take
+	bhi	hfail
+	movem.l	(sp)+,d0/a0
+	rte
+
+hfail:	failt	99
+unexp:	failt	98
+
+fail_all:
+	bsr	nocache
+	move.w	d7,(FAILREG).l
+	move.w	#$BAD,(DONEREG).l
+	bra.s	*
