+				.wbe(wbe[gs*SL +: SL]), .wdata(wdata[gs*SL*8 +: SL*8]),
+				.raddr(raddr), .q(qr[gs*SL*8 +: SL*8]));
 		end
 	endgenerate
 	generate
@@ -53,6 +59,64 @@
 		end
 	endgenerate
 endmodule
+
+// one slice of ap68040_sdp_be: SL bytes (1..4), byte enables, one M10K
+module ap68040_sdp_be_slice #(
+	parameter int AW = 6,
+	parameter int SL = 4
+)(
+	input  logic              clk,
+	input  logic              we,
+	input  logic [AW-1:0]     waddr,
+	input  logic [SL-1:0]     wbe,
+	input  logic [SL*8-1:0]   wdata,
+	input  logic [AW-1:0]     raddr,
+	output logic [SL*8-1:0]   q
+);
+	// Each byte's write is spelled out (Intel's template, "edit this code
+	// if using other than four bytes per word"): with the bytes written in
+	// a for loop Quartus 17.0 infers the memory only when the byte enables
+	// are constant, and makes flip-flops of it when they are not.
+	(* ramstyle = "M10K, no_rw_check" *) logic [SL-1:0][7:0] mem [0:(1<<AW)-1];
+	generate
+		if (SL == 4) begin : g4
+			always_ff @(posedge clk) begin
+				if (we) begin
+					if (wbe[0]) mem[waddr][0] <= wdata[7:0];
+					if (wbe[1]) mem[waddr][1] <= wdata[15:8];
+					if (wbe[2]) mem[waddr][2] <= wdata[23:16];
+					if (wbe[3]) mem[waddr][3] <= wdata[31:24];
+				end
+				q <= mem[raddr];
+			end
+		end
+		else if (SL == 3) begin : g3
+			always_ff @(posedge clk) begin
+				if (we) begin
+					if (wbe[0]) mem[waddr][0] <= wdata[7:0];
+					if (wbe[1]) mem[waddr][1] <= wdata[15:8];
+					if (wbe[2]) mem[waddr][2] <= wdata[23:16];
+				end
+				q <= mem[raddr];
+			end
+		end
+		else if (SL == 2) begin : g2
+			always_ff @(posedge clk) begin
+				if (we) begin
+					if (wbe[0]) mem[waddr][0] <= wdata[7:0];
+					if (wbe[1]) mem[waddr][1] <= wdata[15:8];
+				end
+				q <= mem[raddr];
+			end
+		end
+		else begin : g1
+			always_ff @(posedge clk) begin
+				if (we && wbe[0]) mem[waddr][0] <= wdata[7:0];
+				q <= mem[raddr];
+			end
+		end
+	endgenerate
+endmodule
 
